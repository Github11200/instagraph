# Copy this file to .env and fill in what you want. Everything stays on your machine.

# --- Option A: username + password -------------------------------------------
# Instagraph opens a real browser window, fills these in, and waits for you to
# finish any 2FA / "was this you?" checks. The resulting session cookies are
# saved to data/session.json so you only have to do this once.
IG_USERNAME=
IG_PASSWORD=

# --- Option B: paste a session cookie (skips the browser login) ---------------
# In a browser where you're logged in to instagram.com: DevTools -> Application
# -> Cookies -> https://www.instagram.com -> copy the value of "sessionid".
IG_SESSIONID=

# --- Optional -----------------------------------------------------------------
# Browser used for the login window. Auto-detected (chromium / chrome / brave)
# if empty; otherwise falls back to Playwright's bundled Chromium.
BROWSER_PATH=

HOST=127.0.0.1
PORT=8765
# Open the web app in your default browser on start
OPEN_BROWSER=true
